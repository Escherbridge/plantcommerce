# Required. Replace every placeholder; do not commit a real credential.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
PUBLIC_BASE_URL="http://localhost:5173"
# Use `status` only for the truthful content release while the production schema baseline is pending.
AEVANI_RELEASE_MODE="status"

# Destructive UAT seeding is disabled unless both values are set for a disposable *_dev, *_test, or *_uat database.
AEVANI_UAT_SEED_CONFIRM=""
AEVANI_UAT_SEED_PASSWORD=""
# Used only by the optional local default-admin seed helper; never use a shared default password.
AEVANI_DEV_ADMIN_PASSWORD=""

# Production account-email delivery. Use a send-only Resend key and a verified sender identity.
RESEND_API_KEY="re_replace_me"
EMAIL_FROM="Aevani <support@example.com>"
# Keep disabled until 0004_auth_capabilities.sql has passed its target preflight and a disposable rehearsal.
AUTH_CAPABILITIES_ENABLED="false"
# Enables the unique-record UPSERT throttle. Activate with the capability flag after the same 0004 rehearsal.
AUTH_ATOMIC_THROTTLES_ENABLED="false"

# Private 32-byte-or-longer random secret used to authenticate guest-cart cookies.
GUEST_CART_COOKIE_SECRET="replace-with-a-32-byte-random-secret"

# Leave disabled until 0006_affiliate_attribution.sql has passed its target preflight and a disposable rehearsal.
AFFILIATE_ATTRIBUTION_ENABLED="false"
# Private 32-byte-or-longer random secret for signed, opaque affiliate-attribution capabilities.
AFFILIATE_ATTRIBUTION_COOKIE_SECRET="replace-with-a-different-32-byte-random-secret"

# Keep disabled until 0007_affiliate_commission_ledger.sql has passed its target preflight and a disposable rehearsal.
# Attributed Stripe fulfillment fails closed while this is disabled; unattributed checkout remains unaffected.
AFFILIATE_LEDGER_ENABLED="false"

# Disabled by default. No PlantGeo endpoint or credential is bundled with this application.
# Enable only after a scoped machine identity, HTTPS endpoint, API token, HMAC secret, and delivery design are provisioned.
PLANTGEO_INTEGRATION_ENABLED="false"
PLANTGEO_EVENTS_ENDPOINT=""
PLANTGEO_SERVICE_IDENTITY=""
PLANTGEO_API_TOKEN=""
PLANTGEO_IDENTIFIER_HASH_SECRET=""
# The inbound read-only catalog endpoint is separately disabled. It never serves an empty catalog as published data.
PLANTGEO_CATALOG_READ_ENABLED="false"
PLANTGEO_CATALOG_READ_TOKEN=""

# Stripe private credentials. Keep them server-side and use Stripe test keys locally.
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
# Leave disabled until the target-specific checkout migration rehearsal is approved.
SECURE_CHECKOUT_ENABLED="false"

# Railway S3-Compatible Object Storage
S3_ENDPOINT="https://your-railway-s3-endpoint.railway.app"
S3_REGION="us-east-1"
S3_BUCKET_NAME="aevani-assets"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"

# PostHog Configuration
POSTHOG_API_KEY="your-posthog-api-key"
POSTHOG_HOST="https://app.posthog.com"
